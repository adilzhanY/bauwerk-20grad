{
  "name": "lod2-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared core for the LoD2 pipeline: CityGML streaming parser, geometry metrics, terrain, AdV codelists, types",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./geometry": "./src/geometry.ts",
    "./parser": "./src/parser.ts",
    "./metrics": "./src/metrics.ts",
    "./codelists": "./src/codelists.ts",
    "./api": "./src/api.ts",
    "./terrain": "./src/terrain.ts",
    "./photo": "./src/photo.ts",
    "./wall": "./src/wall.ts",
    "./homography": "./src/homography.ts",
    "./rectify": "./src/rectify.ts",
    "./openings": "./src/openings.ts",
    "./exif": "./src/exif.ts",
    "./survey": "./src/survey/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "saxes": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
