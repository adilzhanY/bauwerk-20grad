# Copy to deploy/.env on the server, fill in, then: chmod 600 deploy/.env
# deploy/.env is ignored by git. Never commit real values.

# The domain the site answers on, without https://. Caddy gets its certificate for it once the
# DNS A and AAAA records point at this server. For a plain HTTP test on a laptop use :80.
DOMAIN=

# Password of the PostGIS database on this server (LoD2 data, and projects until section E).
# Long and random, for example: openssl rand -hex 24
POSTGRES_PASSWORD=

# The database for accounts, projects and every user's data, in Supabase (TODO Part 20): the
# session pooler connection string from the Supabase dashboard, Connect, "Session pooler",
# with the database password filled in. Empty keeps everything in the local PostGIS.
BAUWERK_DATABASE_URL=
# Supabase's certificate authority, so the database certificate is checked rather than trusted
# blindly: Supabase dashboard, Database, Settings, SSL, download the certificate, then paste
# its whole text here in double quotes, line breaks as \n, or leave empty for the local database.
DATABASE_CA_CERT=

# Accounts (username and password, checked by our own server): the secret the server signs
# sessions with, at least 32 characters, for example: openssl rand -base64 48
# Changing it signs everybody out. Empty: no accounts, and then ACCOUNTS=off must say so,
# otherwise the server refuses to start rather than run open.
AUTH_SECRET=
# ACCOUNTS=off

# SAM 3 on a rented graphics card (TODO section H): its https address, and the shared key the
# vision service checks. Empty: "Detect openings" stays hidden, everything else works.
VISION_URL=
VISION_KEY=

# Host ports; leave at 80 and 443 on the server. For a test on a laptop, for example 8088.
HTTP_PORT=80
HTTPS_PORT=443
