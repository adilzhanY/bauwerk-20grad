# Copy to deploy/.env on the server, fill in, then: chmod 600 deploy/.env
# deploy/.env is ignored by git. Never commit real values.

# The domain the site answers on, without https://. Caddy gets its certificate for it once the
# DNS A and AAAA records point at this server. For a plain HTTP test on a laptop use :80.
DOMAIN=

# Password of the PostGIS database on this server (LoD2 data, and projects until section E).
# Long and random, for example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Projects in Supabase (TODO section E): the session pooler connection string from the
# Supabase dashboard, Connect, "Session pooler", with sslmode=require. Empty keeps them local.
BAUWERK_DATABASE_URL=

# Accounts (TODO section F). The project URL, https://<ref>.supabase.co, and the publishable
# (anon) key, which is meant to be public and goes into the app build. Empty: no accounts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for a Supabase project still on the legacy shared JWT secret; empty otherwise.
SUPABASE_JWT_SECRET=

# SAM 3 on a rented graphics card (TODO section H): its https address, and the shared key the
# vision service checks. Empty: "Detect openings" stays hidden, everything else works.
VISION_URL=
VISION_KEY=

# Host ports; leave at 80 and 443 on the server. For a test on a laptop, for example 8088.
HTTP_PORT=80
HTTPS_PORT=443
