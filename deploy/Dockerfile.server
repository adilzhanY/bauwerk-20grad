# The collaboration server. It imports the app's pure code (src/geometry, src/sync) through
# the "@/" path alias, so it is built from the repository root. tsx runs it, because NestJS
# needs decorators, which Node's own type stripping does not do.
FROM node:24-slim
WORKDIR /repo/server
COPY server/package.json server/package-lock.json ./
# --ignore-scripts: Playwright's post-install would download a browser the server never uses.
RUN npm ci --legacy-peer-deps --ignore-scripts
COPY server/tsconfig.json ./
COPY server/migrations ./migrations
COPY server/src ./src
COPY src /repo/src
ENV HOST=0.0.0.0 PORT=8789 NODE_ENV=production
EXPOSE 8789
USER node
CMD ["npx", "tsx", "src/main.ts"]
