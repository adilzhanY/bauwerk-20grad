# The collaboration server. It imports the app's pure code (src/geometry, src/sync) through
# the "@/" path alias, so it is built from the repository root. tsx runs it, because NestJS
# needs decorators, which Node's own type stripping does not do.
FROM node:24-slim
WORKDIR /repo/server
COPY server/package.json server/package-lock.json ./
# --ignore-scripts: Playwright's post-install would download a browser the server never uses.
RUN npm ci --legacy-peer-deps --ignore-scripts
COPY server/tsconfig.json ./
COPY server/migrations ./migrations
COPY server/src ./src
COPY src /repo/src
# The shared maths imports lod2-core (the survey's roof and age tables), linked by path as in the app.
COPY lod2/lod2-core /repo/lod2/lod2-core
RUN npm --prefix /repo/lod2/lod2-core ci --omit=dev \
 && ln -s /repo/lod2/lod2-core /repo/server/node_modules/lod2-core
# The app's code in /repo/src imports packages too (zod for the shared account rules); Node looks
# for them in /repo/node_modules, beside it, so that points at the server's installed packages.
RUN ln -s /repo/server/node_modules /repo/node_modules
ENV HOST=0.0.0.0 PORT=8789 NODE_ENV=production
EXPOSE 8789
USER node
CMD ["npx", "tsx", "src/main.ts"]
