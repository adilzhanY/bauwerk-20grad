# One site. {$DOMAIN} is the bare domain on the server (HTTPS from Let's Encrypt, on its own
# once the DNS records point here); ":80" for a plain HTTP test on a laptop.
# The graphics card is paid by the hour: only a signed in person may use it. Caddy asks the
# collaboration server about the request's token first (/auth/me answers 200 for a valid one)
# and passes the request on only then; anyone else gets the 401 back.
(signed_in) {
	forward_auth server:8789 {
		uri /auth/me
	}
}

{$DOMAIN::80} {
	encode zstd gzip
	# Every answer, the proxied ones too. No page is meant to be framed (PDF previews are blob
	# URLs, which this does not touch). Browsers ignore HSTS over plain HTTP (":80").
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# The largest project file the server takes (50 MB, as Supabase's free plan allows); Caddy
	# refuses anything bigger before it reaches a service.
	request_body {
		max_size 50MiB
	}

	# The LoD2 API: tiles, building detail, search.
	handle_path /api/* {
		reverse_proxy lod2-api:8788
	}

	# The collaboration server: REST and Socket.IO (WebSocket upgrades pass through).
	handle_path /collab/* {
		reverse_proxy server:8789
	}

	# SAM 3 on a rented graphics card, when there is one. Without VISION_URL the default
	# refuses the connection: the app gets a 502 and hides "Detect openings".
	handle_path /vision/* {
		import signed_in
		reverse_proxy {$VISION_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up X-Vision-Key {$VISION_KEY:none}
			# The user's token was checked above; the rented card never sees it.
			header_up -Authorization
		}
	}

	# Floor plan reading, on the same rented card or its own (FLOORPLAN_URL); without it the
	# app hides the floor plan import, as for the photos.
	handle_path /floorplan/* {
		import signed_in
		reverse_proxy {$FLOORPLAN_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
			header_up X-Vision-Key {$VISION_KEY:none}
			# The user's token was checked above; the rented card never sees it.
			header_up -Authorization
		}
	}

	# The app. Its routes (/editor, /gebaeude/<id>) are paths, not files.
	handle {
		root * /srv/app
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
